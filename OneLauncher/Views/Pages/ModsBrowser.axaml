<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OneLauncher.Views.ModsBrowser"
			 xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
			 xmlns:vm="using:OneLauncher.Views.ViewModels"
			 xmlns:controls="using:OneLauncher.Views.Controls"
			 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
			 xmlns:col="clr-namespace:System.Collections;assembly=System.Runtime"
			 xmlns:icons="using:OneLauncher.Converters"
			 x:CompileBindings="True"
			 x:DataType="vm:ModsBrowserViewModel"
			 >
	<UserControl.Resources>
		<!-- 提供商与资源类型共用：图标 + 名称，说明放入提示。 -->
		<DataTemplate x:Key="ResourceOptionTemplate" x:DataType="sys:Object">
			<StackPanel Orientation="Horizontal" Spacing="8"
						ToolTip.Tip="{Binding Converter={StaticResource UiOptionConverter}, ConverterParameter=Description}">
				<controls:ThemeIcon Width="20" Height="20" VerticalAlignment="Center"
									IconKey="{Binding Converter={StaticResource UiOptionConverter}, ConverterParameter=Icon}"/>
				<TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource UiOptionConverter}}"/>
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>
	<controls:PageShell IsPaneOpen="{Binding IsPaneShow,Mode=TwoWay}"
						PaneContent="{Binding PaneContent}">
		<ScrollViewer>
			<StackPanel>
				<TextBlock Classes="page-title" Text="资源检索" Margin="24,22,24,8"/>
				<Grid Margin="24,4,24,12" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
					<TextBox Classes="search-field" Watermark="{Binding SearchWatermark}"
							 Text="{Binding SearchContent}"
							 >
						<TextBox.KeyBindings>
							<KeyBinding Gesture="Enter" Command="{Binding RefListCommand,Mode=TwoWay}" />
						</TextBox.KeyBindings>
					</TextBox>
					<!-- 提供商下拉：每项显示图标 + 名称；“两者”同时显示两个提供商。 -->
					<ComboBox Grid.Column="1" x:Name="ResourceSourceSelector" Classes="toolbar-field"
							  ItemsSource="{Binding ResourceSourceOptions}"
							  SelectedItem="{Binding SelectedResourceSources, Mode=TwoWay}"
							  ToolTip.Tip="资源提供商" AutomationProperties.Name="资源提供商">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="col:IEnumerable">
								<ItemsControl ItemsSource="{Binding}" VerticalAlignment="Center"
											  ItemTemplate="{StaticResource ResourceOptionTemplate}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal" Spacing="12"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
								</ItemsControl>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<ComboBox Grid.Column="2" x:Name="ResourceTypeSelector" Classes="toolbar-field"
							  ItemsSource="{Binding ResourceTypes}" SelectedItem="{Binding SelectedResourceType, Mode=TwoWay}"
							  ItemTemplate="{StaticResource ResourceOptionTemplate}"
							  MinWidth="120"
							  AutomationProperties.Name="资源类型"/>
					<Button Grid.Column="3" Classes="toolbar-action" Command="{Binding RefListCommand}">
						<StackPanel Orientation="Horizontal">
							<Image Source="{DynamicResource IconSearch}" Width="20" Height="20"/>
							<TextBlock Text="搜索"/>
						</StackPanel>
					</Button>
					<Button Grid.Column="4" Classes="toolbar-action" Command="{Binding ClearTextBoxCommand}" IsVisible="{Binding CanClear}">
						<StackPanel Orientation="Horizontal">
							<Image Source="{DynamicResource IconDel}" Width="20" Height="20" />
							<TextBlock Text="清除" /> 
						</StackPanel>
					</Button>
				</Grid>
				<TextBlock Classes="item-meta" Text="{Binding SearchStatus}" IsVisible="{Binding HasSearchStatus}"
						   TextWrapping="Wrap" Margin="24,0,24,12"/>
				<ListBox Classes="card-list" ItemsSource="{Binding Items}" Margin="18,0">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ResourceItem">
							<Border Padding="12">
								<Grid RowDefinitions="*,*" ColumnDefinitions="100,*,Auto" >
									<Border Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" >
										<Image Width="72" Height="72" asyncImageLoader:ImageLoader.Source="{Binding IconUrl}"/>
									</Border>
									<TextBlock Classes="item-title" TextWrapping="Wrap" Grid.Row="0" Margin="6" Grid.Column="1" Text="{Binding Title}"/>
									<SelectableTextBlock Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="4,8,0,0" Grid.Row="1" Grid.Column="1" Text="{Binding Description}"/>
									<Button Classes="item-action" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Command="{Binding $parent[ListBox].DataContext.ToInstallResourceCommand}" CommandParameter="{Binding}">
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="安装"/>
										</StackPanel>
									</Button>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</ScrollViewer>
	</controls:PageShell>
</UserControl>
