<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OneLauncher.Views.Panes.PaneViewModels"
             xmlns:controls="using:OneLauncher.Views.Controls"
             xmlns:lo="clr-namespace:OneLauncher.Core.Helper.Models;assembly=OneLauncher.Core"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="620"
             x:DataType="vm:NewGameDataPaneViewModel"
             x:CompileBindings="True"
             x:Class="OneLauncher.Views.Panes.NewGameDataPane">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <controls:PaneHeader Grid.Row="0" Title="新建游戏数据" BackCommand="{Binding CancelCommand}"/>
        <Separator Grid.Row="1" Classes="pane-divider"/>

        <ScrollViewer Grid.Row="2">
            <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" Spacing="16" Margin="0,0,0,20">
                <TextBlock Classes="pane-section-title" Text="基础版本"/>
                <Border Classes="pane-surface">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="pane-label" Text="游戏版本"/>
                        <ComboBox Classes="pane-field" ItemsSource="{Binding AvailableBaseVersions}"
                                  SelectedItem="{Binding SelectedBaseVersion}" PlaceholderText="选择已安装的游戏版本">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="lo:UserVersion">
                                    <TextBlock Text="{Binding VersionID}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <TextBlock Classes="pane-section-title" Text="实例信息"/>
                <Border Classes="pane-surface">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="pane-label" Text="实例名称"/>
                        <TextBox Classes="pane-field" Text="{Binding GameDataName}"
                                 IsEnabled="{Binding SelectedBaseVersion, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 Watermark="例如：我的整合包"/>
                        <TextBlock Classes="pane-label" Text="模组加载器" Margin="0,8,0,0"/>
                        <ComboBox Classes="pane-field" ItemsSource="{Binding AvailableModLoaders}"
                                  SelectedItem="{Binding SelectedModLoader}"
                                  IsEnabled="{Binding SelectedBaseVersion, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="lo:ModEnum">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <controls:ThemeIcon Width="22" Height="22" VerticalAlignment="Center"
                                                            IconKey="{Binding Converter={StaticResource UiOptionConverter}, ConverterParameter=Icon}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Converter={StaticResource UiOptionConverter}}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Converter={StaticResource UiOptionConverter}, ConverterParameter=Description}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="pane-label" Text="默认登录账户" Margin="0,8,0,0"/>
                        <ComboBox Classes="pane-field" ItemsSource="{Binding AvailableAccounts}"
                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                  IsEnabled="{Binding SelectedBaseVersion, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameDataAccountOption">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="pane-help"
                                   Text="选择全局默认账户后，启动时使用设置中的默认账户。"/>
                    </StackPanel>
                </Border>

                <TextBlock Classes="pane-section-title" Text="工具"/>
                <Border Classes="pane-surface">
                    <StackPanel Spacing="8">
                        <CheckBox Content="一键安装所有推荐模组"
                                  IsChecked="{Binding InstallRecommendedMods, Mode=TwoWay}"
                                  IsEnabled="{Binding CanInstallRecommendedMods}"/>
                        <TextBlock Classes="pane-help"
                                   Text="创建完成后会在后台从 Modrinth 下载适配当前加载器和版本的推荐模组，可在任务列表查看进度或取消安装。"/>
                        <TextBlock Classes="pane-help"
                                   IsVisible="{Binding !CanInstallRecommendedMods}"
                                   Text="请先选择 Fabric、Quilt、Forge 或 NeoForge 加载器，再启用推荐模组安装。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,16,0,0">
            <Button Grid.Column="0" Classes="pane-secondary" Content="取消" Command="{Binding CancelCommand}"/>
            <Button Grid.Column="1" Classes="pane-primary" Content="创建" Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</UserControl>
