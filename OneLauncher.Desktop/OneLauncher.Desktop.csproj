<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<Nullable>enable</Nullable>
		<ApplicationManifest Condition="'$(OneLauncherTargetOS)' == 'Windows'">app.manifest</ApplicationManifest>
		<Platforms>AnyCPU;x64;ARM64</Platforms>
		<Configurations>Debug;Release;ReleaseAot</Configurations>
		<PublishAot Condition="'$(Configuration)' == 'ReleaseAot'">true</PublishAot>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="StaticLink.Avalonia" Version="3.119.4.1" Condition="'$(OneLauncherNativeSingleFile)' == 'true'" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\OneLauncher.Console\OneLauncher.Console.csproj" />
		<ProjectReference Include="..\OneLauncher\OneLauncher.csproj" />
	</ItemGroup>
	<PropertyGroup>
		<ApplicationIcon>window-logo.ico</ApplicationIcon>
	</PropertyGroup>
	<Import Project="../build/PublishValidation.targets" />
	<Import Project="../build/NativeSingleFile.targets" />
</Project>
